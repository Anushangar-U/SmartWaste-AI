# Backend and authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
DATABASE_PATH=data/smartwaste.sqlite3
USE_MOCK_AGENTS=true
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000,http://127.0.0.1:5500
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Agent 1 provider: auto, groq, openrouter, or gemini
AGENT1_PROVIDER=auto

# Agent 1 - Groq (uses GROQ_API_KEY; optional model override)
AGENT1_GROQ_MODEL=

# Agent 1 - OpenRouter
AGENT1_OPENROUTER_API_KEY=
AGENT1_OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# Agent 1 - Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Agent 2 - OpenRouter grounded knowledge generation
# The fallback key is tried only for rate limits, timeouts, connection failures, or 5xx errors.
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional photo analysis - uses OPENROUTER_API_KEY when live
# Set VISION_MODEL to a vision-capable OpenRouter model identifier.
VISION_MODEL=
VISION_MAX_IMAGE_MB=5
VISION_MAX_DIMENSION=1800
UPLOAD_DIR=data/uploads

# Agent 3 - Groq decision agent
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Frontend
BACKEND_URL=http://localhost:8000

# Bounded demo/operational controls (single backend worker)
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=1
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_LEASE_SECONDS=600
MAX_CONCURRENT_PROCESSING=2
PUBLIC_REQUESTS_PER_MINUTE=30
AUTH_REQUESTS_PER_MINUTE=20
DUPLICATE_WINDOW_DAYS=7
DUPLICATE_SIMILARITY_THRESHOLD=0.82
RETENTION_DAYS=90
